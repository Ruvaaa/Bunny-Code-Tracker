{
  "name": "bunny-code-tracker",
  "displayName": "Bunny Code Tracker",
  "description": "A bunny that follows your cursor around VS Code",
  "version": "0.0.2",
  "icon": "icon.png",
  "publisher": "Ruvaaaaaa",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruvaaa/Bunny-Code-Tracker"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bunny-code-tracker.start",
        "title": "Bunny Code Tracker: Toggle"
      }
    ],
    "configuration": {
      "title": "Bunny Code Tracker",
      "properties": {
        "bunnyCodeTracker.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Show the bunny automatically when VS Code opens."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "bunny:test": "electron overlay/bunny-window.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "electron": "^44.5.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}